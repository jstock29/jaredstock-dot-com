rules_version = '2';

// Project and publication media is public to read. Uploads are limited to admins (see firestore.rules),
// to images and videos, and to 50 MB per file.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /{folder}/{allPaths=**} {
      allow read: if folder in ['projects', 'publications'];
      allow create, update: if folder in ['projects', 'publications'] && isAdmin()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if folder in ['projects', 'publications'] && isAdmin();
    }
  }
}
